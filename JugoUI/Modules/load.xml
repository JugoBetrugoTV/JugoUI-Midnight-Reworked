<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/FrameXML/UI_shared.xsd">
    <!--
        JugoUI Module Loader
        Loads all modules in proper order
    -->

    <!-- Unit Frames -->
    <Include file="UnitFrames\load.xml"/>

    <!-- Raid Frames -->
    <Include file="RaidFrames\load.xml"/>

    <!-- Nameplates -->
    <Include file="Nameplates\load.xml"/>

    <!-- Castbars -->
    <Include file="Castbars\load.xml"/>

    <!-- Action Bars -->
    <Include file="ActionBars\load.xml"/>

    <!-- Bags -->
    <Include file="Bags\load.xml"/>

    <!-- Chat -->
    <Include file="Chat\load.xml"/>

    <!-- Minimap -->
    <Include file="Minimap\load.xml"/>

    <!-- Tooltip -->
    <Include file="Tooltip\load.xml"/>

    <!-- Info Bar -->
    <Include file="InfoBar\load.xml"/>

    <!-- XP/Reputation Bar -->
    <Include file="XPRepBar\load.xml"/>

    <!-- Skins -->
    <Include file="Skins\load.xml"/>

    <!-- Buffs/Auras -->
    <Include file="Buffs\load.xml"/>

    <!-- Quality of Life / Miscellaneous -->
    <Include file="Misc\load.xml"/>

    <!-- Profiles -->
    <Include file="Profiles\load.xml"/>

    <!-- Credits -->
    <Include file="Credits\load.xml"/>

</Ui>
