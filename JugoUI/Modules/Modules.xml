<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/FrameXML/UI_shared.xsd">
    <!--
        JugoUI Module Loader
        Loads all modules in proper order
    -->

    <!-- Unit Frames -->
    <Include file="UnitFrames\UnitFrames.xml"/>

    <!-- Raid Frames -->
    <Include file="RaidFrames\RaidFrames.xml"/>

    <!-- Nameplates -->
    <Include file="Nameplates\Nameplates.xml"/>

    <!-- Castbars -->
    <Include file="Castbars\Castbars.xml"/>

    <!-- Action Bars -->
    <Include file="ActionBars\ActionBars.xml"/>

    <!-- Bags -->
    <Include file="Bags\Bags.xml"/>

    <!-- Chat -->
    <Include file="Chat\Chat.xml"/>

    <!-- Minimap -->
    <Include file="Minimap\Minimap.xml"/>

    <!-- Tooltip -->
    <Include file="Tooltip\Tooltip.xml"/>

    <!-- Info Bar -->
    <Include file="InfoBar\InfoBar.xml"/>

    <!-- XP/Reputation Bar -->
    <Include file="XPRepBar\XPRepBar.xml"/>

    <!-- Skins -->
    <Include file="Skins\Skins.xml"/>

    <!-- Buffs/Auras -->
    <Include file="Buffs\Buffs.xml"/>

    <!-- Quality of Life / Miscellaneous -->
    <Include file="Misc\Misc.xml"/>

    <!-- Profiles -->
    <Include file="Profiles\Profiles.xml"/>

    <!-- Credits -->
    <Include file="Credits\Credits.xml"/>

</Ui>
