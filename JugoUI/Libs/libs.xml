<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/FrameXML/UI_shared.xsd">
    <!--
        JugoUI Library Loader
        Required Libraries for Midnight (12.0)

        Download these from CurseForge/WoWInterface:
        - Ace3 (AceAddon, AceDB, AceDBOptions, AceConfig, AceGUI, AceConsole, AceEvent, AceHook, AceTimer, AceComm, AceSerializer)
        - LibStub
        - CallbackHandler
        - LibSharedMedia
        - LibDualSpec
        - LibDataBroker
        - LibDBIcon
        - LibActionButton
        - LibCustomGlow
        - LibRangeCheck
        - LibDispellable
        - LibClassicDurations (for backwards compatibility)
        - LibDeflate (compression)
        - LibSerialize
        - UTF8 (string handling)
    -->

    <!-- LibStub - Foundation for all libraries -->
    <Include file="LibStub\LibStub.lua"/>

    <!-- CallbackHandler - Event handling for libraries -->
    <Include file="CallbackHandler-1.0\CallbackHandler-1.0.xml"/>

    <!-- Ace3 Libraries -->
    <Include file="AceAddon-3.0\AceAddon-3.0.xml"/>
    <Include file="AceDB-3.0\AceDB-3.0.xml"/>
    <Include file="AceDBOptions-3.0\AceDBOptions-3.0.xml"/>
    <Include file="AceEvent-3.0\AceEvent-3.0.xml"/>
    <Include file="AceHook-3.0\AceHook-3.0.xml"/>
    <Include file="AceTimer-3.0\AceTimer-3.0.xml"/>
    <Include file="AceConsole-3.0\AceConsole-3.0.xml"/>
    <Include file="AceGUI-3.0\AceGUI-3.0.xml"/>
    <Include file="AceConfig-3.0\AceConfig-3.0.xml"/>
    <Include file="AceComm-3.0\AceComm-3.0.xml"/>
    <Include file="AceSerializer-3.0\AceSerializer-3.0.xml"/>
    <Include file="AceLocale-3.0\AceLocale-3.0.xml"/>

    <!-- Shared Media -->
    <Include file="LibSharedMedia-3.0\lib.xml"/>

    <!-- Data Broker -->
    <Include file="LibDataBroker-1.1\LibDataBroker-1.1.lua"/>
    <Include file="LibDBIcon-1.0\lib.xml"/>

    <!-- Action Button Library -->
    <Include file="LibActionButton-1.0\LibActionButton-1.0.lua"/>

    <!-- Utility Libraries -->
    <Include file="LibCustomGlow-1.0\LibCustomGlow-1.0.lua"/>
    <Include file="LibRangeCheck-3.0\LibRangeCheck-3.0.lua"/>
    <Include file="LibDispellable-1.0\LibDispellable-1.0.lua"/>
    <Include file="LibDeflate\LibDeflate.lua"/>
    <Include file="LibSerialize\LibSerialize.lua"/>
    <Include file="UTF8\utf8.lua"/>

    <!-- Dual Spec Support -->
    <Include file="LibDualSpec-1.0\LibDualSpec-1.0.lua"/>

</Ui>
